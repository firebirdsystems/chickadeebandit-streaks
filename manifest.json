{
  "id": "streaks",
  "contexts": ["household", "shared_space"],
  "name": "Streaks",
  "version": "1.1.0",
  "description": "Track personal and family habits with streak counters. Create private or shared streaks, set up group challenges anyone can check off, and celebrate milestones together.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": ["habits", "wellness", "fitness", "goals", "streaks"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "agenda": {"kind": "other", "label": "Streak", "source": {"kind": "sql", "query": "SELECT s.id AS id, s.title AS title, s.owner_id AS member_id, :today AS when_at, CASE WHEN l.id IS NULL THEN 0 ELSE 1 END AS done FROM app_streaks__streaks s LEFT JOIN app_streaks__streak_logs l ON l.streak_id = s.id AND l.logged_date = :today WHERE s.archived_at IS NULL LIMIT 20"}},
  "glance": {"source": {"kind": "sql", "query": "SELECT COUNT(*) AS n FROM app_streaks__streaks s LEFT JOIN app_streaks__streak_logs l ON l.streak_id = s.id AND l.logged_date = :today WHERE s.archived_at IS NULL AND l.id IS NULL LIMIT 1"}, "display": {"template": "badge", "count": "n", "label": "streaks to keep", "severity": "warn"}},
  "nav": {
    "label": "Streaks"
  },
  "storage": "db",
  "automation_actions": {
    "start_streak": {
      "title": "Start a streak for a member",
      "description": "Begin a streak when another app's event fires — a habit taken up, a goal set, a routine someone commits to.",
      "params": {
        "owner_id": {
          "type": "member",
          "label": "Whose streak",
          "required": true
        },
        "title": {
          "type": "text",
          "label": "Streak title",
          "required": true
        }
      },
      "dedupe": {
        "table": "streaks",
        "column": "source_event_id"
      },
      "steps": [
        {
          "op": "insert",
          "table": "streaks",
          "values": {
            "id": "$uuid",
            "owner_id": ":owner_id",
            "title": ":title",
            "created_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
    "member_references": {
      "streaks": {
        "column": "owner_id",
        "on_removed": "delete",
        "dependent_tables": [
          {
            "table": "streak_logs",
            "foreign_key": "streak_id"
          }
        ]
      },
      "streak_logs": {
        "column": "logged_by",
        "on_removed": "keep"
      }
    },
  "delete_cascades": {
    "streaks": [
      { "table": "streak_logs", "foreign_key": "streak_id" }
    ]
  },
  "row_policies": {
    "streaks": {
      "kind": "owner_or_visibility",
      "member_column": "owner_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "adult_values": ["adults", "everyone"],
      "write_owner_only": true
    },
    "streak_logs": {
      "kind": "inherit_visibility",
      "fk_column": "streak_id",
      "parent_table": "streaks",
      "writer_column": "logged_by",
      "insert_non_owner_parent_truthy_column": "is_group",
      "retain_days": { "default": 365, "timestamp_column": "created_at", "override_key": "streak_history" }
    }
  },
  "exports": ["member-streaks"],
  "publishes": ["streak.milestone"],
  "publish_acls": {
    "streak.milestone": { "require_role": "adult" }
  },
  "widget": { "label": "Streaks", "size": "small" },
  "resource_limits": { "max_db_bytes": 52428800 },
  "icon": "🔥",
  "ai_access": {
    "allowed": true,
    "mode": "read_write",
    "db_exports": ["active_streaks", "todays_completions"],
    "db_inserts": ["log_streak"],
    "db_deletes": ["unlog_streak"]
  }
}
